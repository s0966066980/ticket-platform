# Docker Compose public entry point. Only this port is published.
HTTP_PORT=8080

# Local development database defaults. When changing these, update DATABASE_URL
# too; percent-encode reserved URI characters in its username/password.
POSTGRES_DB=ticket_platform
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket-local-only
DATABASE_URL=postgresql+psycopg://ticket:ticket-local-only@postgres:5432/ticket_platform

# Internal payment transport and signatures. Replace the example secret before
# using the stack beyond the documented local demonstration.
GATEWAY_SECRET=ticket-local-gateway-change-me

# Idempotent startup seed: one account of each role. These are demo credentials.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=Admin-local-2026!
SEED_USER_EMAIL=user@example.test
SEED_USER_PASSWORD=User-local-2026!
SEED_VIEWER_EMAIL=viewer@example.test
SEED_VIEWER_PASSWORD=Viewer-local-2026!

# Domain time limits, upload limits and bounded processing defaults.
HOLD_SECONDS=300
IDEMPOTENCY_LEASE_SECONDS=30
IDEMPOTENCY_RETENTION_HOURS=24
SNAPSHOT_TTL_SECONDS=600
IMPORT_MAX_BYTES=20000000
IMPORT_MAX_ROWS=100000
IMPORT_BATCH_SIZE=1000
WORKER_POLL_SECONDS=1
GATEWAY_POLL_SECONDS=5
WS_VERSION_CHECK_SECONDS=5
WS_QUEUE_SIZE=256
METRICS_WINDOW_SECONDS=60
DISPLAY_TIMEZONE=Asia/Taipei

# Initial alert rules: at least 20 requests and 15 continuous seconds.
ALERT_ERROR_RATE=0.05
ALERT_P95_SECONDS=1
ALERT_OUTBOX_LAG_SECONDS=10
ALERT_MIN_REQUESTS=20
ALERT_SUSTAIN_SECONDS=15

# Compose fixes internal service URLs and /data paths, including NGINX_LOG_PATH.
# Host-only development tools (not read by Compose):
# PYTHON_BIN=python3.13
# PG_BIN=/usr/lib/postgresql/16/bin
# PG_TEST_PORT=55432
# PG_TEST_DATABASE=ticket_test
# PG_RUNTIME_DIR=/absolute/path/to/dedicated/runtime
# TEST_DATABASE_URL=postgresql+psycopg://ticket_test@127.0.0.1:55432/ticket_test
