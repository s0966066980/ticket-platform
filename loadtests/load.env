# Isolated load-test stack (compose project "ticket-load"). Disposable demo
# credentials only, never production. Used by scripts/loadtest.sh as the
# compose --env-file and to build the host-side database URL.

# Public entry point of the load stack (the demo stack keeps 8080).
HTTP_PORT=8081
# PostgreSQL published on localhost for fixture generation and the consistency
# audit. Kept apart from 55432, which scripts/run_tests.sh prefers.
LOAD_DB_PORT=55433

POSTGRES_DB=ticket_platform_load
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket-load-only
DATABASE_URL=postgresql+psycopg://ticket:ticket-load-only@postgres:5432/ticket_platform_load
GATEWAY_SECRET=ticket-load-gateway-secret
